    "@microsoft/tsdoc": "^0.15.1",
    "@rushstack/node-core-library": "^4.3.0",
    "@types/fs-extra": "^11.0.4",
    "@types/lodash": "^4.17.16",
    "@types/react": "^19.1.4",
    "@types/resolve": "^1.20.6",
    "fs-extra": "^11.3.0",
    "gh-pages": "^6.3.0",
    "moment": "^2.30.1",
    "prettier": "^3.5.3",
    "resolve": "^1.22.10",
    "xmlbuilder": "^15.1.1"
  },
  "engines": {
    "node": ">=22.12.0"
