    "@antv/g-canvas": "^2.2.0",
    "@antv/g-plugin-rough-canvas-renderer": "^2.1.1",
    "@antv/g-svg": "^2.0.38",
    "@antv/g2": "^5.3.2",
    "@antv/g6": "workspace:*",
    "@antv/g6-extension-3d": "workspace:*",
    "@antv/g6-extension-react": "workspace:*",
    "@antv/layout-gpu": "^1.1.7",
    "@antv/util": "^3.3.10",
    "@antv/vendor": "^1.0.11",
    "antd": "^5.25.1",
    "astro": "^7.2.0",
    "lil-gui": "^0.19.2",
    "lodash": "^4.17.21",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "styled-components": "^6.1.18"
  },
  "devDependencies": {
    "@manypkg/get-packages": "^2.2.2",
